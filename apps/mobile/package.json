{
  "name": "@glimpse/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:core": "zsh ./scripts/run-ios-with-core.sh",
    "ios:device:core": "zsh ./scripts/run-ios-with-core.sh --device",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:bridge:ios": "zsh ./scripts/build-bridge-rust-ios.sh",
    "build:bridge:android": "zsh ./scripts/build-bridge-rust-android.sh",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-share-extension",
          "rustra-jsi"
        ]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@expo/plist": "^0.4.8",
    "@expo/vector-icons": "^15.0.3",
    "@glimpse/bridge-generated": "workspace:*",
    "@glimpse/shared": "workspace:*",
    "@glimpse/ui": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.5.2",
    "@react-navigation/native": "^7.1.6",
    "@rn-primitives/alert-dialog": "^1.2.0",
    "@rn-primitives/avatar": "^1.2.0",
    "@rn-primitives/portal": "~1.3.0",
    "@rn-primitives/progress": "^1.2.0",
    "@rn-primitives/separator": "^1.2.0",
    "@rn-primitives/slot": "^1.2.0",
    "@rn-primitives/switch": "^1.2.0",
    "@rn-primitives/tabs": "^1.2.0",
    "@rn-primitives/tooltip": "~1.2.0",
    "@rustra/react-native": "0.1.3",
    "@rustra/types": "0.1.3",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@toss/hangul": "^1.7.1",
    "baseline-browser-mapping": "^2.9.19",
    "caniuse-lite": "^1.0.30001766",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "effect": "^3.19.17",
    "expo": "~55.0.29",
    "expo-background-task": "~55.0.21",
    "expo-blur": "~55.0.17",
    "expo-clipboard": "~55.0.16",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.17",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.23",
    "expo-linking": "~55.0.17",
    "expo-navigation-bar": "~55.0.16",
    "expo-network": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.17",
    "expo-share-extension": "^5.0.6",
    "expo-share-intent": "^6.1.1",
    "expo-splash-screen": "~55.0.24",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.21",
    "expo-task-manager": "~55.0.19",
    "expo-web-browser": "~55.0.19",
    "llama.rn": "^0.11.0",
    "lucide-react-native": "^0.563.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-blob-util": "^0.24.7",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-buffer": "^0.2.2",
    "react-native-nitro-crypto": "^0.3.2",
    "react-native-nitro-modules": "^0.35.10",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "uniwind": "^1.2.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native-reusables/cli": "^0.6.3",
    "@tanstack/eslint-plugin-query": "^5.81.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "bun-types": "^1.3.9",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.8",
    "expo-build-properties": "~55.0.17",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
