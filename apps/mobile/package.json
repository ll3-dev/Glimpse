{
  "name": "@glimpse/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:core": "zsh ./scripts/run-ios-with-core.sh",
    "ios:device:core": "zsh ./scripts/run-ios-with-core.sh --device",
    "web": "expo start --web",
    "web:export": "expo export --platform web --output-dir dist-web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "build:bridge:ios": "zsh ./scripts/build-bridge-rust-ios.sh",
    "build:bridge:android": "zsh ./scripts/build-bridge-rust-android.sh",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "sync:e2e": "bun scripts/sync-headless-e2e.ts"
  },
  "expo": {
    "autolinking": {
      "searchPaths": [
        "../../node_modules",
        "./node_modules"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-share-extension",
          "rustra-jsi"
        ]
      },
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "dependencies": {
    "@expo/plist": "^0.4.8",
    "@expo/vector-icons": "^15.0.3",
    "@glimpse/bridge-generated": "workspace:*",
    "@glimpse/features": "workspace:*",
    "@glimpse/shared": "workspace:*",
    "@glimpse/ui": "workspace:*",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.5.2",
    "@react-navigation/native": "^7.1.6",
    "@rustra/react-native": "0.6.0",
    "@rustra/types": "0.6.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.83.0",
    "@toss/hangul": "^1.7.1",
    "baseline-browser-mapping": "^2.9.19",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "effect": "^3.22.1",
    "expo": "^57",
    "expo-background-task": "~57.0.14",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-navigation-bar": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "^57.0.15",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-share-extension": "^5.0.6",
    "expo-share-intent": "^8.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "llama.rn": "^0.12.9",
    "lucide-react-native": "^0.563.0",
    "pako": "^3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.7",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-buffer": "^0.2.2",
    "react-native-nitro-crypto": "^0.3.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "uniwind": "^1.2.7",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@react-native-reusables/cli": "^0.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/pako": "^3.0.0",
    "@types/react": "~19.2.10",
    "babel-plugin-inline-import": "^3.0.0",
    "bun-types": "^1.3.9",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "expo-build-properties": "~57.0.15",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
