{
  "expo": {
    "name": "Glimpse",
    "slug": "glimpse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "glimpse",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f6f3"
    },
    "ios": {
      "bundleIdentifier": "kr.ll3.glimpse",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "지식 보관함에 이미지와 스크린샷을 저장하기 위해 사진 라이브러리 접근 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "이미지를 저장하기 위해 사진 라이브러리 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "문서 및 스크린샷 캡처를 위해 카메라 접근 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.kr.ll3.glimpse"
        ]
      }
    },
    "android": {
      "package": "kr.ll3.glimpse",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#f7f6f3"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsTextWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "extraEntitlements": {
              "com.apple.developer.kernel.extended-virtual-addressing": true,
              "com.apple.developer.kernel.increased-memory-limit": true
            }
          }
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": true,
          "entitlementsProfile": "production",
          "forceCxx20": true,
          "enableOpenCLAndHexagon": true
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      "expo-font",
      "expo-image",
      "expo-router",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ShareExtension",
                  "bundleIdentifier": "kr.ll3.glimpse.share-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.kr.ll3.glimpse"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
