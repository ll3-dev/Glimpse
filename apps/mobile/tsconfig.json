{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "types": ["bun-types"],
    "composite": true,
    "paths": {
      "@/*": ["./*"],
      "effect": ["./node_modules/effect"],
      "effect/*": ["./node_modules/effect/*"],
      "@glimpse/shared": ["../../packages/shared/src/index.ts"],
      "@glimpse/shared/*": ["../../packages/shared/src/*"],
      "@glimpse/ui": ["../../packages/ui/src/index.ts"],
      "@glimpse/ui/*": ["../../packages/ui/src/*"],
      "@glimpse/specs": ["./src/features/core/specs/index.ts"],
      "@glimpse/specs/*": ["./src/features/core/specs/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "generate/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.tsx",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios",
    "dist",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js"
  ]
}
