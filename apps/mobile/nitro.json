{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["glimpse"],
  "ios": {
    "iosModuleName": "GlimpseCore"
  },
  "android": {
    "androidNamespace": ["com", "glimpse", "mobile"],
    "androidCxxLibName": "glimpse_core"
  },
  "autolinking": {
    "CoreClient": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridCoreClient"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ],
  "gitAttributesGeneratedFlag": false
}
