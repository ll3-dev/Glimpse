{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "effect": ["../mobile/node_modules/effect"],
      "effect/*": ["../mobile/node_modules/effect/*"],
      "@/*": ["./src/*"],
      "@glimpse/core": ["../../packages/core/src/index.ts"],
      "@glimpse/core/*": ["../../packages/core/src/*"],
      "@glimpse/shared": ["../../packages/shared/src/index.ts"],
      "@glimpse/shared/*": ["../../packages/shared/src/*"],
      "@glimpse/hooks": ["../../packages/hooks/src/index.ts"],
      "@glimpse/hooks/*": ["../../packages/hooks/src/*"],
      "@glimpse/features": ["../../packages/features/src/index.ts"],
      "@glimpse/features/*": ["../../packages/features/src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/core/src/**/*.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/hooks/src/**/*.ts",
    "../../packages/hooks/src/**/*.tsx",
    "../../packages/features/src/**/*.ts",
    "../../packages/features/src/**/*.tsx"
  ]
}
